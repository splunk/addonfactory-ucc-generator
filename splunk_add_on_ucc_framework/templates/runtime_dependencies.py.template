        if name not in provided_modules or name in shared_namespaces:
            roots.extend(bundled)
        origin = getattr(cached, "__file__", None)
        origins = ([origin] if origin else []) + list(getattr(cached, "__path__", []))
        if (not origins or any(not any(_inside(path, root) for root in roots) for path in origins)
                or (name in provided_namespaces and origin)):
            raise _unexpected_cached_dependency(name)
        if name in shared_namespaces:
            paths = shared_namespaces[name]
            namespace_updates.append((cached, paths))
            namespace_updates.extend(_cached_namespace_updates(name, paths))
    for cached, paths in namespace_updates:
        cached.__path__ = paths
        if cached.__spec__ is not None:
            cached.__spec__.submodule_search_locations = paths

    bindir = os.path.join(app, "bin")
    namespace = os.path.join(bindir, os.path.basename(app))
    allowed = {_real(lib): set(manifest["source_modules"]["lib"]),
               _real(bindir): set(manifest["source_modules"]["bin"]),
               _real(namespace): set(manifest["source_modules"]["namespace"])}
    for directory in bundled:
        allowed[_real(directory)] = set(profile["modules"])
    for names in allowed.values():
