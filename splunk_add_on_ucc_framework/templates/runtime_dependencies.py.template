            spec = importlib.machinery.PathFinder.find_spec(fullname, search, target)
            if spec is not None:
                return spec
            if importlib.machinery.PathFinder.find_spec(fullname, sys.path, target) is not None:
                raise ModuleNotFoundError("No declared runtime dependency named " + fullname)
            # Let other finders try a name absent from all filesystem paths.
