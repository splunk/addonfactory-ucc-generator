        actual = installed.get(name)
        if actual is None or actual.version != expected:
            raise RuntimeError("UCC dependency %s must be %s in %s" % (name, expected, bundled))
    core_paths = [path for path in sys.path if not _inside(path, app)
                  and _real(path) != _real(app) and not re.search(r"[\\/]etc[\\/]apps[\\/]", path)]
    core = {}
    for path in core_paths:
        for dist in importlib.metadata.distributions(path=[path]):
            # Python imports from the first matching path.
            core.setdefault(_canonical(dist.metadata["Name"]), dist)
    provided_modules = set()
    provided_roots = {}
    provided_namespaces = {}
    for name, expected in profile["provided"].items():
        distribution = core.get(name)
        if distribution is None or distribution.version != expected:
            raise RuntimeError("Splunk-provided %s must match locked version %s; validate the host's dependency contract" %
                               (name, expected))
        top_level = distribution.read_text("top_level.txt")
        names = set(top_level.splitlines()) if top_level else {
            str(path).split("/")[0].split(".")[0] for path in (distribution.files or [])
            if str(path).split("/")[0].split(".")[0].isidentifier()
            and ".dist-info" not in str(path) and ".data/" not in str(path)}
        provided_modules.update(names)
        for module_name in names:
            root = str(distribution.locate_file(""))
            provided_roots.setdefault(module_name, set()).add(root)
            namespace_paths = _namespace_paths(module_name, [root])
            if namespace_paths:
                provided_namespaces.setdefault(module_name, set()).update(namespace_paths)

    # Implicit namespaces can contain distributions from both the locked graph
    # and Splunk. Concrete modules/packages still belong to their provided root.
    shared_namespaces = {}
    core_path_order = {path: i for i, path in enumerate(dict.fromkeys(map(_real, core_paths)))}
    for name in set(profile["modules"]) & set(provided_namespaces):
        bundled_paths = _namespace_paths(name, bundled)
        if bundled_paths:
            host_paths = sorted(
                provided_namespaces[name],
                key=lambda path: (core_path_order.get(_real(os.path.dirname(path)), len(core_paths)), path),
            )
            shared_namespaces[name] = bundled_paths + host_paths

    namespace_updates = []
    for name in set(profile["modules"]) | provided_modules:
        cached = sys.modules.get(name)
        if cached is None:
            continue
