# Generated by UCC. Configure meta.dependencyProfiles in the source add-on.
import os
import sys

# Load the selector's standard-library dependencies before exposing add-on paths.
# Python 3.9's importlib.metadata imports configparser during initialization.
_ucc_app = os.path.normcase(os.path.dirname(os.path.dirname(os.path.realpath(__file__))))
_ucc_saved_paths = sys.path[:]
sys.path[:] = [entry for entry in sys.path
               if not (os.path.normcase(os.path.realpath(entry or os.curdir)) == _ucc_app
                       or os.path.normcase(os.path.realpath(entry or os.curdir)).startswith(_ucc_app + os.sep)
                       or (os.sep + "etc" + os.sep + "apps" + os.sep) in entry)]
try:
    import importlib.machinery
    import importlib.metadata
    import json
    import platform
    import re
finally:
    sys.path[:] = _ucc_saved_paths
del _ucc_app, _ucc_saved_paths


def _canonical(name):
    return re.sub(r"[-_.]+", "-", name).lower()


def _real(path):
    return os.path.normcase(os.path.realpath(path or os.curdir))


def _inside(path, parent):
    return _real(path).startswith(_real(parent) + os.sep)


def _configure_runtime():
    app = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
    lib = os.path.join(app, "lib")
    with open(os.path.join(lib, "ucc-runtime-dependencies.json")) as reader:
        manifest = json.load(reader)
    if manifest.get("version") != 1:
        raise RuntimeError("Unsupported UCC dependency manifest version")
    system = "windows" if sys.platform.startswith("win") else sys.platform
    machine = platform.machine().lower()
    architecture = {"amd64": "x86_64", "aarch64": "arm64"}.get(machine, machine)
    matches = [profile for profile in manifest["profiles"]
               if profile["os"] == system and profile["architecture"] == architecture
               and profile["python"] == list(sys.version_info[:2])]
    if len(matches) != 1:
        raise RuntimeError("No unique UCC dependency profile for %s/%s/Python %s.%s" %
                           (system, architecture, *sys.version_info[:2]))
    profile = matches[0]
    if platform.python_version() != profile["python_full_version"]:
        raise RuntimeError("UCC dependency profile targets Python %s; regenerate the lock for Python %s" %
                           (profile["python_full_version"], platform.python_version()))
    minimum = profile["minimum_openssl"]
    selected = os.path.realpath(os.path.join(lib, profile["path"]))
    if not _inside(selected, lib) or not os.path.isdir(selected):
        raise RuntimeError("Missing or invalid UCC dependency directory: " + selected)

    installed = {_canonical(dist.metadata["Name"]): dist
                 for dist in importlib.metadata.distributions(path=[selected])}
    for name, expected in profile["distributions"].items():
        actual = installed.get(name)
        if actual is None or actual.version != expected:
            raise RuntimeError("UCC dependency %s must be %s in %s" % (name, expected, selected))
    for name in profile["modules"]:
        cached = sys.modules.get(name)
        if cached is not None:
            origins = [getattr(cached, "__file__", None)] or []
            origins = [origin for origin in origins if origin]
            origins.extend(list(getattr(cached, "__path__", [])))
            if not origins or any(not _inside(origin, selected) for origin in origins):
                raise RuntimeError("Dependency %s was imported before the UCC profile; start a fresh process" % name)

    core_paths = [path for path in sys.path if not _inside(path, app)
                  and _real(path) != _real(app) and not re.search(r"[\\/]etc[\\/]apps[\\/]", path)]
    core = {_canonical(dist.metadata["Name"]): dist
            for dist in importlib.metadata.distributions(path=core_paths)}
    provided_modules = set()
    for name, expected in profile["provided"].items():
        distribution = core.get(name)
        if distribution is None or distribution.version != expected:
            raise RuntimeError("Splunk-provided %s must match locked version %s; validate the host's dependency contract" %
                               (name, expected))
        top_level = distribution.read_text("top_level.txt")
        names = set(top_level.splitlines()) if top_level else {
            str(path).split("/")[0].split(".")[0] for path in (distribution.files or [])
            if str(path).split("/")[0].split(".")[0].isidentifier()
            and ".dist-info" not in str(path) and ".data/" not in str(path)}
        provided_modules.update(names)
        for module_name in names:
            cached = sys.modules.get(module_name)
            if cached is not None and not _inside(getattr(cached, "__file__", ""), str(distribution.locate_file(""))):
                raise RuntimeError("Splunk-provided %s was imported from an unexpected location" % module_name)

    bindir = os.path.join(app, "bin")
    namespace = os.path.join(bindir, os.path.basename(app))
    allowed = {_real(lib): set(manifest["source_modules"]["lib"]),
               _real(bindir): set(manifest["source_modules"]["bin"]),
               _real(namespace): set(manifest["source_modules"]["namespace"]),
               _real(selected): set(profile["modules"])}
    for names in allowed.values():
        names.difference_update(provided_modules)

    class DeclaredDependencies:
        def find_spec(self, fullname, path=None, target=None):
            if path is not None:
                return None
            name = fullname.partition(".")[0]
            search = [entry for entry in sys.path
                      if _real(entry) not in allowed or name in allowed[_real(entry)]]
            if search == sys.path:
                return None
            spec = importlib.machinery.PathFinder.find_spec(fullname, search, target)
            if spec is None:
                raise ModuleNotFoundError("No declared runtime dependency named " + fullname)
            return spec

    # Keep built-in and frozen importers ahead of this path-filtering finder.
    position = next((i for i, finder in enumerate(sys.meta_path)
                     if finder is importlib.machinery.PathFinder), len(sys.meta_path))
    sys.meta_path.insert(position, DeclaredDependencies())
    paths = [entry for entry in sys.path if not _inside(entry, app)
             and _real(entry) != _real(app) and not re.search(r"[\\/]etc[\\/]apps[\\/]", entry)]
    sys.path[:] = [selected, namespace, lib] + paths
    # Keep this add-on's bin available for its declared helpers.
    sys.path.append(bindir)
    # Splunk's ssl module can import certifi. Select dependencies before loading it.
    if minimum:
        import ssl
        if tuple(ssl.OPENSSL_VERSION_INFO[:3]) < tuple(minimum):
            raise RuntimeError("UCC dependency profile requires OpenSSL %s" % ".".join(map(str, minimum)))


_configure_runtime()
