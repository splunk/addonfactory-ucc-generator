    sys.path[:] = _ucc_saved_paths
del _ucc_app, _ucc_saved_paths


def _canonical(name):
    return re.sub(r"[-_.]+", "-", name).lower()


def _real(path):
    return os.path.normcase(os.path.realpath(path or os.curdir))


def _inside(path, parent):
    return _real(path).startswith(_real(parent) + os.sep)


def _namespace_paths(name, paths):
    spec = importlib.machinery.PathFinder.find_spec(name, paths)
    if spec is not None and spec.origin is None and spec.submodule_search_locations is not None:
        return list(spec.submodule_search_locations)
    return []


def _unexpected_cached_dependency(name):
    return RuntimeError("Dependency %s was imported before the UCC profile from an unexpected location; start a fresh process" % name)


def _cached_namespace_updates(name, paths):
    # Resolve descendants from the selected namespace paths, without consulting
    # the cached parents' paths or importing their code.
    search_paths = {name: paths}
    updates = []
    for fullname, cached in sorted(sys.modules.copy().items()):
        if cached is None or not fullname.startswith(name + "."):
            continue
        parent = fullname.rpartition(".")[0]
        if parent not in search_paths:
            raise _unexpected_cached_dependency(fullname)
        spec = importlib.machinery.PathFinder.find_spec(fullname, search_paths[parent])
        if spec is None:
            raise _unexpected_cached_dependency(fullname)

        origin = getattr(cached, "__file__", None)
        if spec.origin is not None:
            if origin is None or _real(origin) != _real(spec.origin):
                raise _unexpected_cached_dependency(fullname)
        elif origin is not None:
            raise _unexpected_cached_dependency(fullname)

        if spec.submodule_search_locations is not None:
            locations = list(spec.submodule_search_locations)
            expected = {_real(path) for path in locations}
            cached_paths = getattr(cached, "__path__", None)
            if cached_paths is None or any(_real(path) not in expected for path in cached_paths):
                raise _unexpected_cached_dependency(fullname)
            search_paths[fullname] = locations
            if spec.origin is None:
                updates.append((cached, locations))
    return updates


def _configure_runtime():
    app = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
    lib = os.path.join(app, "lib")
    with open(os.path.join(lib, "ucc-runtime-dependencies.json")) as reader:
        manifest = json.load(reader)
    if manifest.get("version") != 1:
        raise RuntimeError("Unsupported UCC dependency manifest version")
    system = "windows" if sys.platform.startswith("win") else sys.platform
    machine = platform.machine().lower()
    architecture = {"amd64": "x86_64", "aarch64": "arm64"}.get(machine, machine)
    matches = [profile for profile in manifest["profiles"]
               if profile["os"] == system and profile["architecture"] == architecture
               and profile["python"] == list(sys.version_info[:2])]
    if len(matches) != 1:
        raise RuntimeError("No unique UCC dependency profile for %s/%s/Python %s.%s" %
                           (system, architecture, *sys.version_info[:2]))
    profile = matches[0]
    if platform.python_version() != profile["python_full_version"]:
        raise RuntimeError("UCC dependency profile targets Python %s; regenerate the lock for Python %s" %
                           (profile["python_full_version"], platform.python_version()))
    minimum = profile["minimum_openssl"]
    bundled = []
    for relative in [profile["path"], *profile.get("shared_paths", [])]:
        directory = os.path.realpath(os.path.join(lib, relative))
        if not _inside(directory, lib) or not os.path.isdir(directory) or directory in bundled:
            raise RuntimeError("Missing or invalid UCC dependency directory: " + directory)
        bundled.append(directory)

